{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "import"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn"
  },
  "rules": {
    "eqeqeq": "error",
    "curly": "error",
    "no-console": "warn",
    "no-var": "error",
    "prefer-const": "error",
    "typescript/consistent-type-imports": "error",
    "typescript/no-explicit-any": "warn",
    "import/no-duplicates": "error"
  },
  "ignorePatterns": ["dist", "playground/src/generated", "**/worker-configuration.d.ts"],
  "overrides": [
    {
      "files": ["playground/scripts/**"],
      "rules": { "no-console": "off" }
    }
  ]
}
