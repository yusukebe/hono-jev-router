{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jev-router-playground",
  "compatibility_date": "2026-09-01",
  "main": "./src/index.tsx",
  "worker_loaders": [{ "binding": "LOADER" }],
  "ai": { "binding": "AI" },
  "ratelimits": [
    // Runs of user code, per IP
    { "name": "RUN_LIMITER", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } },
    // Calls to Jev, per IP. User code can call the JEV binding as often as it likes, so count here too
    { "name": "JEV_LIMITER", "namespace_id": "1002", "simple": { "limit": 12, "period": 60 } },
  ],
  "vars": { "AI_GATEWAY_ID": "default" },
}
